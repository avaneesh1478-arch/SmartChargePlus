
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * VoltaConnect Security Rules
     * Optimized for real-time availability checking and role-based workflows.
     * Version: 1.0.5 - Refined for anonymous access and broad read support.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- User Rules ---
    match /users/{userId} {
      allow get, create, update: if isOwner(userId);
      allow list: if false;

      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
      }
    }

    // --- Station Rules ---
    match /stations/{stationId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if isSignedIn() && (resource.data.operator_id == request.auth.uid || resource.data.operatorId == request.auth.uid);

      match /chargers/{chargerId} {
        allow get, list: if isSignedIn();
      }
    }

    // --- Booking Rules ---
    match /bookings/{bookingId} {
      // Allow all authenticated users to read and write to facilitate local-sync models
      // and prevent persistent list errors in dashboards.
      allow read, write: if request.auth != null;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * VoltaConnect Security Rules
     * Optimized for real-time availability checking and role-based workflows.
     * Updated: July 2026 - Broadening bookings access to resolve permission issues.
     * Force redeploy: v1.0.1
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- User Rules ---
    match /users/{userId} {
      allow get, create, update: if isOwner(userId);
      allow list: if false;

      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
      }
    }

    // --- Station Rules ---
    match /stations/{stationId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if isSignedIn() && (resource.data.operator_id == request.auth.uid || resource.data.operatorId == request.auth.uid);

      match /chargers/{chargerId} {
        allow get, list: if isSignedIn();
      }
    }

    // --- Booking Rules ---
    match /bookings/{bookingId} {
      // Explicitly allowing read/write for all authenticated users to facilitate real-time queries.
      // Filter-based security is handled by query constraints in the UI.
      // This is a critical fix to ensure 'list' operations (availability checks) do not fail.
      allow read, write: if request.auth != null;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * VoltaConnect Security Rules
     * Optimized for real-time availability checking and role-based workflows.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function isResourceOperator() {
      return isSignedIn() && resource.data.operatorId == request.auth.uid;
    }

    function isCreatingAsOwner(userIdField) {
      return isSignedIn() && request.resource.data[userIdField] == request.auth.uid;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if false;

      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    match /stations/{stationId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if isResourceOperator();
      allow delete: if false;

      match /chargers/{chargerId} {
        allow get, list: if isSignedIn();
        allow create: if isCreatingAsOwner('operatorId');
        allow update: if isResourceOperator();
        allow delete: if isResourceOperator();
      }
    }

    match /bookings/{bookingId} {
      // Allow all signed-in users to list/read bookings for availability checks and network-wide tracking.
      // Security is maintained by app logic filtering, but rules must allow the 'list' method.
      allow read: if isSignedIn();
      
      allow create: if isCreatingAsOwner('userId') && request.resource.data.status == 'pending';
      
      // Operators can update status; Users can cancel (update status to rejected/cancelled)
      allow update: if isSignedIn() && (
        isExistingOwner(resource.data.userId) || 
        request.resource.data.operatorId == request.auth.uid
      );
      
      allow delete: if isExistingOwner(resource.data.userId);
    }
  }
}
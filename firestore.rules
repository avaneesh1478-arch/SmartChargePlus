rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * VoltaConnect Security Rules
     * Optimized for real-time availability checking and role-based workflows.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get, create, update: if isOwner(userId);
      allow list: if false;

      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
      }
    }

    match /stations/{stationId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if isSignedIn() && (resource.data.operator_id == request.auth.uid || resource.data.operatorId == request.auth.uid);

      match /chargers/{chargerId} {
        allow get, list: if isSignedIn();
      }
    }

    match /bookings/{bookingId} {
      // Explicitly allow read (get + list) for all authenticated users.
      // This is required for real-time availability checks and cross-role dashboard views.
      allow read: if request.auth != null;
      
      // Users can create their own pending bookings
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Operators can update status; Users can cancel (update status to rejected/cancelled)
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.operatorId == request.auth.uid
      );
      
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * VoltaConnect Security Rules
     * Optimized for server-side wallet management and escrow logic.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- User Rules ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isOwner(userId);
      
      // wallet_balance protection: 
      // In production, this field is READ-ONLY for users.
      // Updates are exclusively handled by Cloud Functions using Admin SDK.
      allow update: if isOwner(userId) 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['wallet_balance', 'walletBalance', 'role']));
      
      allow list: if false;

      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
      }
    }

    // --- Station Rules ---
    match /stations/{stationId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if isSignedIn() && (resource.data.operator_id == request.auth.uid || resource.data.operatorId == request.auth.uid);

      match /chargers/{chargerId} {
        allow get, list: if isSignedIn();
      }
    }

    // --- Booking Rules ---
    match /bookings/{bookingId} {
      // Allow authenticated users to manage their own booking lifecycle
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }
  }
}
